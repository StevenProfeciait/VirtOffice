# TEVA HQ / VirtOffice — Environment Configuration
#
# This file is OPTIONAL. server.py and scripts/teva_sync.py load a file named
# `.env` in the project root automatically (standard library only), and real
# environment variables ALWAYS override values written here.
#
# Copy to .env only when you want overrides:
#   cp .env.example .env
#
# The dashboard works with zero config (demo mode) or with any of these:

# --- Server (local-only by default) -----------------------------------------
# The server refuses non-loopback binds unless the explicit container flag
# below is set. Do not set HOST=0.0.0.0 for a normal local run.
PORT=9502
HOST=127.0.0.1

# Container-only escape hatch: allow HOST=0.0.0.0 / :: inside an isolated
# container network. The Docker image sets this itself; docker-compose
# publishes the host port on 127.0.0.1 only. Leave unset locally.
# TEVA_ALLOW_NON_LOOPBACK=1

# --- Workspace sync (board/doc sources) -------------------------------------
# Repo that holds docs/TEVA_COMPANY_BACKLOG.md etc. for the office board sync.
# Default is this repository; point it at your workspace to enable live sync
# (scripts/teva_sync.py prints a clear message when the backlog is not found).
# TEVA_REPO=/absolute/path/to/your/workspace

# --- Cursor monitoring (optional) -------------------------------------------
# Transcript folder override; by default it is derived from TEVA_REPO using
# Cursor's project-slug convention (<path with non-alphanumerics as '-'>).
# CURSOR_TRANSCRIPTS=/absolute/path/to/.cursor/projects/<slug>/agent-transcripts

# --- Bridge Script (recommended) --------------------------------------------
# The bridge script auto-discovers your Hermes agents and writes agents.json.
# Run it in watch mode to keep the dashboard live:
#   python3 scripts/hermes_bridge.py --watch --interval 10
# No config needed — it reads from ~/.hermes/ automatically.

# --- Gateway Port (optional) -------------------------------------------------
# If your Hermes gateway runs on a non-default port:
# GATEWAY_PORT=51763

# --- Hermes API Mode (optional, alternative to bridge) -----------------------
# Point this at your Hermes gateway snapshot endpoint:
# HERMES_AGENT_API=http://localhost:51763/api/snapshot

# --- JSON File Mode (automatic when agents.json exists) ----------------------
# AGENTS_JSON_PATH=./agents.json

# --- Polling ------------------------------------------------------------------
POLL_INTERVAL_SECONDS=5

# --- Server-Sent Events (live browser updates) -------------------------------
ENABLE_SSE=true
